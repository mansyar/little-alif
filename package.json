{
  "name": "little-alif",
  "version": "0.1.0",
  "private": true,
  "description": "Little Alif — Arabic alphabet learning app for children",
  "type": "module",
  "scripts": {
    "i18n": "typesafe-i18n --no-watch",
    "dev": "typesafe-i18n --no-watch && vite dev",
    "build": "typesafe-i18n --no-watch && vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --incremental",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx app/db/seed.ts",
    "generate:audio": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-router-devtools": "^1.95.0",
    "@tanstack/react-start": "^1.95.0",
    "better-auth": "^1.1.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "vinxi": "^0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "6.6.0",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "25.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typesafe-i18n": "5.26.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
