# Application
NODE_ENV=development                 # "production" or "development"

# Database
DATABASE_URL=file:./data/little-alif.db

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-32-char-random-string  # min 32 chars, used for session signing
BETTER_AUTH_URL=http://localhost:3000                      # must match deployment URL

# Child Mode
CHILD_MODE_SECRET=                                        # optional; falls back to BETTER_AUTH_SECRET
