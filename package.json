{
  "name": "little-alif",
  "version": "0.1.0",
  "private": true,
  "description": "Little Alif — Arabic alphabet learning app for children",
  "type": "module",
  "scripts": {
    "i18n": "typesafe-i18n --no-watch",
    "dev": "typesafe-i18n --no-watch && vite dev",
    "build": "typesafe-i18n --no-watch && vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --incremental",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix . --deny-warnings",
    "prepare": "husky",
    "db:push": "drizzle-kit push --force --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx app/db/seed.ts",
    "generate:audio": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-router-devtools": "^1.95.0",
    "@tanstack/react-start": "^1.95.0",
    "better-auth": "^1.1.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2",
    "zod": "^4.4.3",
    "typesafe-i18n": "5.26.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "6.6.0",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "jsdom": "25.0.0",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
